{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource scraping the Euystacio indexer metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Euystacio AI Ecosystem – Live Dashboard",
  "uid": "euystacio-ecosystem",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "tags": ["euystacio", "blockchain", "ai-ecosystem"],
  "panels": [
    {
      "id": 1,
      "title": "AH Pool Balance per L2",
      "type": "bargauge",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "euystacio_ah_pool_balance",
          "legendFormat": "{{l2}}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "thresholds": {
          "steps": [
            { "color": "red",    "value": 0 },
            { "color": "yellow", "value": 20 },
            { "color": "green",  "value": 50 }
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Average AI Reputation Score",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 8 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "avg(euystacio_ai_reputation_score)",
          "legendFormat": "Avg Reputation",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "BioSignal Events (24h)",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 8 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "increase(euystacio_bio_signal_total[24h])",
          "legendFormat": "BioSignals",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "VitalTrust Claim Rate (per hour)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "rate(euystacio_vitaltrust_claims_total[1h])",
          "legendFormat": "Claims/h",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "SilentBridge Message Volume",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "rate(euystacio_silentbridge_messages_total[1h])",
          "legendFormat": "Messages/h",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Rebalancing Events",
      "type": "logs",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 6 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "euystacio_bridge_rebalance_events",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "AH Liquidity Forecast (7-day Prophet model)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 22, "w": 24, "h": 8 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "euystacio_liquidity_forecast",
          "legendFormat": "Forecast {{l2}}",
          "refId": "A"
        },
        {
          "expr": "euystacio_liquidity_forecast_lower",
          "legendFormat": "Lower bound {{l2}}",
          "refId": "B"
        },
        {
          "expr": "euystacio_liquidity_forecast_upper",
          "legendFormat": "Upper bound {{l2}}",
          "refId": "C"
        }
      ]
    }
  ]
}
